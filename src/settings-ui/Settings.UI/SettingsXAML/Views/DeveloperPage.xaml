<local:NavigablePage
    x:Class="Microsoft.PowerToys.Settings.UI.Views.DeveloperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.PowerToys.Settings.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Microsoft.PowerToys.Settings.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Microsoft.PowerToys.Settings.UI.ViewModels"
    AutomationProperties.LandmarkType="Main"
    mc:Ignorable="d">

    <controls:SettingsPageControl
        x:Uid="Developer"
        ModuleTitle="Developer &amp; About PowerTool"
        ModuleDescription="Independent Developer Profile, Community Edition Details, and Custom Issue Reporting"
        IsTabStop="False">
        <controls:SettingsPageControl.ModuleContent>
            <StackPanel ChildrenTransitions="{StaticResource SettingsCardsAnimations}" Orientation="Vertical" Spacing="16">

                <!-- Developer Profile Card -->
                <controls:SettingsGroup Header="Developer Profile">
                    <tkcontrols:SettingsCard
                        Header="En-Dhiaa"
                        Description="Independent Developer &amp; Architect of PowerTool Extended Edition"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE77B;}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <HyperlinkButton
                                Content="github.com/En-Dhiaa"
                                NavigateUri="{x:Bind ViewModel.GitHubProfileUrl}"
                                FontWeight="SemiBold" />
                            <Button
                                Content="View GitHub Profile"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OpenGitHubProfile_Click" />
                        </StackPanel>
                    </tkcontrols:SettingsCard>
                </controls:SettingsGroup>

                <!-- Edition Overview & Enhancements -->
                <controls:SettingsGroup Header="Extended Edition Enhancements">
                    <tkcontrols:SettingsCard
                        Header="Custom Features"
                        Description="Enhanced functionality added to this edition"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE71D;}">
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <TextBlock Text="• Offline Arabic/English Translator (CTranslate2 &amp; SentencePiece)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="• Arabic/English Keyboard Layout Correction (Arabic 101/102 bijection)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="• Modern Windows 11 Visual Identity &amp; High-Resolution Icons" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="• Native Arabic (ar-SA) Interface Localization" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsCard
                        Header="Project Description"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE946;}">
                        <TextBlock
                            Text="{x:Bind ViewModel.EditionDescription}"
                            TextWrapping="Wrap"
                            MaxWidth="550"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </tkcontrols:SettingsCard>
                </controls:SettingsGroup>

                <!-- Custom Issue Reporting & Support -->
                <controls:SettingsGroup Header="Feedback &amp; Issue Reporting">
                    <tkcontrols:SettingsCard
                        Header="Submit Problem / Feedback"
                        Description="Report bugs, request features, or report translation/layout issues directly to En-Dhiaa"
                        HeaderIcon="{ui:FontIcon Glyph=&#xED15;}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <HyperlinkButton
                                Content="github.com/En-Dhiaa/PowerToys/issues"
                                NavigateUri="{x:Bind ViewModel.RepositoryIssuesUrl}" />
                            <Button
                                Content="Report Issue"
                                Click="OpenIssuesPage_Click" />
                        </StackPanel>
                    </tkcontrols:SettingsCard>
                </controls:SettingsGroup>

                <!-- Version, Licensing & Attribution -->
                <controls:SettingsGroup Header="Attribution &amp; Licensing">
                    <tkcontrols:SettingsCard
                        Header="PowerTool Version"
                        Description="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE896;}">
                        <Border
                            Padding="8,4"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4">
                            <TextBlock
                                Text="Extended Edition"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                FontWeight="Bold" />
                        </Border>
                    </tkcontrols:SettingsCard>

                    <tkcontrols:SettingsCard
                        Header="Open Source Attributions"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8A5;}">
                        <TextBlock
                            Text="{x:Bind ViewModel.AttributionNotice}"
                            TextWrapping="Wrap"
                            MaxWidth="550"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </tkcontrols:SettingsCard>
                </controls:SettingsGroup>

            </StackPanel>
        </controls:SettingsPageControl.ModuleContent>

        <controls:SettingsPageControl.PrimaryLinks>
            <controls:PageLink Text="Developer Profile" Link="https://github.com/En-Dhiaa" />
            <controls:PageLink Text="Submit Issue / Feedback" Link="https://github.com/En-Dhiaa/PowerToys/issues/new/choose" />
            <controls:PageLink Text="Upstream PowerToys Repository" Link="https://github.com/microsoft/PowerToys" />
        </controls:SettingsPageControl.PrimaryLinks>
    </controls:SettingsPageControl>
</local:NavigablePage>

